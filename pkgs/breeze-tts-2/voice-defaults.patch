+static void read_num(const JVal & root, const char * key, std::optional<double> & out,
+                     const std::string & path) {
+    const auto it = root.obj.find(key);
+    if (it == root.obj.end() || it->second.kind == JVal::Null) return;
+    if (it->second.kind == JVal::Num) {
+        out = it->second.num;
+        return;
+    }
+    if (it->second.kind == JVal::Str) {
+        char * end = nullptr;
+        const double d = strtod(it->second.str.c_str(), &end);
+        if (end != it->second.str.c_str() && *end == '\0') {
+            out = d;
+            return;
+        }
+    }
+    fprintf(stderr, "%s: %s must be a number, ignoring it\n", path.c_str(), key);
+}
+
+// <name>.json next to <name>.breeze. A malformed or missing file is not fatal: the
+// voice still loads with the request/GenRequest defaults.
+static VoiceDefaults load_defaults(const std::string & path) {
+    VoiceDefaults d;
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) return d;
+    std::string body;
+    char buf[4096];
+    size_t n = 0;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) body.append(buf, n);
+    const bool read_ok = ferror(f) == 0;
+    fclose(f);
+    if (!read_ok) {
+        fprintf(stderr, "%s: read failed, ignoring generation defaults\n", path.c_str());
+        return d;
+    }
+
+    JVal root;
+    if (!JParser(body).parse(root) || root.kind != JVal::Obj) {
+        fprintf(stderr, "%s: not a json object, ignoring generation defaults\n", path.c_str());
+        return d;
+    }
+
+    const auto str = [&](const char * key, std::optional<std::string> & out) {
+        const auto it = root.obj.find(key);
+        if (it == root.obj.end() || it->second.kind == JVal::Null) return;
+        if (it->second.kind == JVal::Str) {
+            if (!it->second.str.empty()) out = it->second.str;
+            return;
+        }
+        fprintf(stderr, "%s: %s must be a string, ignoring it\n", path.c_str(), key);
+    };
+    // the json API calls it instructions, the form API calls it instruction. accept both.
+    str("instructions", d.instruction);
+    if (!d.instruction) str("instruction", d.instruction);
+
+    std::optional<double> cfg, seed, temp, top_k, top_p, rep, max_tok, split;
+    read_num(root, "cfg_scale", cfg, path);
+    read_num(root, "seed", seed, path);
+    read_num(root, "temperature", temp, path);
+    read_num(root, "top_k", top_k, path);
+    read_num(root, "top_p", top_p, path);
+    read_num(root, "repetition_penalty", rep, path);
+    read_num(root, "max_new_tokens", max_tok, path);
+    read_num(root, "split_chars", split, path);
+
+    if (cfg) d.cfg_scale = (float) *cfg;
+    if (seed) d.seed = (int) *seed;
+    if (temp) d.temperature = (float) *temp;
+    if (top_k) d.top_k = (int) *top_k;
+    if (top_p) d.top_p = (float) *top_p;
+    if (rep) d.repetition_penalty = (float) *rep;
+    if (max_tok) d.max_new_tokens = (int) *max_tok;
+    if (split) d.split_chars = (int) *split;
+    return d;
+}
