 #include <string>
 
 namespace breeze {
@@ -17,9 +18,18 @@ struct ServerOptions {
     int chunk_max = 25;
     int split_chars = 600; // 0 keeps long text in a single pass
     bool warmup = true;
+    int idle_unload_seconds = 0; // 0 keeps the model resident for the process lifetime
+    std::string reload_guard; // optional executable run before a reload; non-zero refuses it
     std::string cors; // empty turns cors off, "*" allows any origin, otherwise a comma separated allowlist
 };
 
+// The model can be dropped after an idle period and reloaded by the next request. `touch` records
+// activity; `ensure_loaded` is called with the gpu mutex held and reloads if necessary.
+struct ModelHooks {
+    std::function<void()> touch;
+    std::function<bool()> ensure_loaded;
+};
+
 int run_server(const ServerOptions & opts);
 
 }
